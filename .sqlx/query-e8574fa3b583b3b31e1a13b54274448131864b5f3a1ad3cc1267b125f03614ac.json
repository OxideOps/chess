  "query": "SELECT user_id, rating, deviation, volatility, games,\n                      EXTRACT(EPOCH FROM now() - last_game_at)::float8 AS \"idle_s!\"\n               FROM ratings WHERE category = $1 AND user_id = ANY($2)\n               ORDER BY user_id FOR UPDATE",
